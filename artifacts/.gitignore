# Generated runs stay local. Only reviewed documentation evidence is versioned.
# Keep directories traversable so the file exceptions below can be reached.
*
!*/
!/.gitignore
!/README.md

# Nested demo repositories must be ignored as directories, including their .git.
/git-worktrees/
/worktree-example/
/worktree-example-complete/

