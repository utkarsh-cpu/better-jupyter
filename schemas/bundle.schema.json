{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KernelLedger bundle schema 1",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "notebook_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "checkpoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "blob_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema",
    "notebook_id",
    "session_ids",
    "checkpoint_ids",
    "blob_hashes",
    "external",
    "files"
  ],
  "additionalProperties": true
}
